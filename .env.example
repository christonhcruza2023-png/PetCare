# ---- PetCare environment example ----
# Copy this file to `.env` and adjust the values for your machine.

# MongoDB connection string.
# Local server:      mongodb://localhost:27017
# MongoDB Atlas:     mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017

# Database / collection names
MONGO_DB_NAME=petcare_db
MONGO_COLLECTION=pets

# Flask secret key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Max upload size in megabytes (images)
MAX_UPLOAD_MB=5

# --- Optional bootstrap administrator ---
# If BOTH values are set and the users collection is empty, this
# administrator account is created automatically on first start.
# Leave empty to skip: the first account you register then becomes
# the administrator instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Run flask with debug off in anything shared
FLASK_DEBUG=1
